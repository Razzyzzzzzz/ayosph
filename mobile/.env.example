# Supabase > Project Settings > API (anon/public key only; NEVER the service role key)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Your Express API. Use your computer's LAN IP on a real device (e.g. http://192.168.1.10:4000),
# http://10.0.2.2:4000 on the Android emulator, or your https:// URL in production.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
