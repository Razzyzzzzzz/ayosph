# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET. Server-side only. Never put this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PORT=4000
# Comma-separated allowed web origins (mobile apps don't need CORS). Leave blank to disable CORS.
CORS_ORIGINS=
